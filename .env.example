# ─────────────────────────────────────────────────────────────────────────────
# Wapsi — example environment
# Copy to .env.local (Next.js) and fill in real values. NEVER commit .env.local.
#
# Naming rule that matters more than any single line here:
#   NEXT_PUBLIC_*  is shipped to every browser. Anything secret must NOT have
#   that prefix. The agent's API key with a NEXT_PUBLIC_ prefix would be public.
# ─────────────────────────────────────────────────────────────────────────────

# ── Existing app settings ────────────────────────────────────────────────────
# Spring Boot backend origin (browser-visible, not a secret).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Tester affordances (autofill buttons etc.). "false" removes them everywhere.
NEXT_PUBLIC_MOCK_MODE=true

# ── AI agent (Phase 6) — server-side only, read by API routes ───────────────
# The key never reaches the browser: the browser talks to our /api/agent route,
# and only that route talks to the model provider (Gemini).
GEMINI_API_KEY=AIza-REPLACE_ME

# Optional: Fallback configuration if primary rate limits/quotas are exceeded.
# The agent rotates to the next key on HTTP 429 (lib/agentic/model.ts, 2026-09-06); with every key
# out of quota it falls back to template wording and says so in the run's Progress panel.
# GEMINI_FALLBACK_API_KEY=AIza-REPLACE_ME
# GEMINI_FALLBACK_API_KEY_2=AIza-REPLACE_ME
# GEMINI_FALLBACK_API_KEY_3=AIza-REPLACE_ME
# GEMINI_FALLBACK_API_KEY_4=AIza-REPLACE_ME
# GEMINI_FALLBACK_API_KEY_5=AIza-REPLACE_ME
# GEMINI_FALLBACK_API_KEY_6=AIza-REPLACE_ME
# GEMINI_FALLBACK_API_KEY_7=AIza-REPLACE_ME
# GEMINI_FALLBACK_API_KEY_8=AIza-REPLACE_ME
# Or comma-separated list of keys:
# GEMINI_API_KEYS=key1,key2,key3,key4,key5
# AGENT_FALLBACK_MODEL=gemini-3.5-flash-lite

# User decision 2026-08-28: the 3.5 family. Verified against
# ai.google.dev/gemini-api/docs/models on 2026-08-28: gemini-3.5-flash and
# gemini-3.5-flash-lite are current, stable ids. The docs' recommendation for
# agentic tool-use is gemini-3.7-flash — an env-only upgrade if Flash 3.5
# ever feels short on the multi-step flows.
AGENT_MODEL=gemini-3.5-flash
# Fallback models, tried on the same key when the primary is out of quota (free-tier quotas are per
# model — found live 2026-09-07: 20 requests a day on gemini-3.5-flash, the lite model untouched).
AGENT_SMALL_MODEL=gemini-3.5-flash-lite
# Per-call timeout for the model. Default 20000 ms since 2026-09-07 evening: one call is now a thinking turn with tool
# calls (lib/agentic/brain.ts), not a phrasing of a brief. Env still wins.
# AGENT_MODEL_TIMEOUT_MS=20000

# Hard ceilings, enforced by our route before any call is made.
# 2026-09-03: reply cap lowered 4096 -> 2048. The system prompt now asks for
# 1-3 sentence answers by default; 2048 still fits a full computation
# walk-through or regime comparison while halving worst-case spend.
AGENT_MAX_TOKENS_PER_REPLY=2048
AGENT_MAX_TURNS_PER_SESSION=40
# Citizen questions (user turns) per chat session. Hard-capped at 4 in code:
# this value may LOWER the cap, never raise it. The 5th question is refused
# server-side without calling the model; the UI locks the input after the 4th
# with "Sorry, we have limited our chat" and offers no reset (protects the key).
AGENT_MAX_QUESTIONS_PER_SESSION=4
AGENT_DAILY_TOKEN_BUDGET=2000000

# ── Agent behaviour policy (mirrors PLAN.md Phase 6 — change deliberately) ──
# The agent calls the same backend API the UI uses, as the signed-in user.
# It authenticates with the user's own session token, so it can never read or
# write anything the user themselves could not.
AGENT_BACKEND_URL=http://localhost:8080

# "true" = irreversible actions (file a return, raise a dispute) only PREPARE
# and require the human to click confirm in the UI. Never set false in a demo:
# autonomous filing changes the liability story mid-pitch.
AGENT_REQUIRE_CONFIRMATION=true

# Hypothetical computations run against the engine only; ledger writes refused.
AGENT_SANDBOX_HYPOTHETICALS=true

# Store every agent session transcript (who asked what, which tools ran,
# what changed) so a CA can audit what the agent did on a client's return.
AGENT_TRANSCRIPTS_ENABLED=true

# ── Agentic workspace + vault (plan.md 2026-09-05) — read by API routes ─────
# Durable stores (vault documents, return snapshots, agent runs, memory).
# Leave unset and the app runs with process-memory stores for the three demo
# personas only, disclosed to the user as non-durable; real citizens get 503.
# Any one of these three names is accepted (Supabase/Vercel Postgres/Java).
# DATABASE_URL=postgres://wapsi:REPLACE_ME@localhost:5432/wapsi
# POSTGRES_URL=
# WAPSI_DATASOURCE_URL=

# Vault encryption key: 32 random bytes, base64. Without it the vault refuses
# to store originals (metadata-only). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# WAPSI_VAULT_KEY=REPLACE_ME

# "false" hides the Agentic route (/app) and the Agentic/Manual switch.
NEXT_PUBLIC_WAPSI_AGENTIC=true

# Per-run ceilings for the server-owned agent runtime (lib/agentic). Since 2026-09-07 the model
# decides what to do and calls tools (Gemini function calling); every figure it says still comes
# from the engine through a tool, and every reply is checked for figures it was never given.
# GEMINI_API_KEY / AGENT_MODEL above are reused; unset → the one honest offline line, no menu.
AGENT_MODEL_TIMEOUT_MS=12000
AGENT_MAX_TOOL_CALLS_PER_RUN=40
# One turn of the conversation is 2–4 model calls (a thought, tool results, the reply); a chat is many turns.
# 12 ended a live chat after four turns on 2026-09-07 — raise it in .env.
AGENT_MAX_MODEL_CALLS_PER_RUN=120

# ── OTP / auth (backend, application.properties or env-injected) ───────────
# fixed  -> codes are AuthConfig.MOCK_CODE (949494), knowable from source only.
# random -> real SecureRandom codes; you must then wire real delivery.
WAPSI_OTP_MODE=fixed

# Postgres. Leave unset to run fully in-memory (the app boots with no DB).
# WAPSI_DATASOURCE_URL=jdbc:postgresql://localhost:5432/wapsi
# WAPSI_DATASOURCE_USERNAME=wapsi
# WAPSI_DATASOURCE_PASSWORD=REPLACE_ME

# ── Dictation (speech to text) — faster-whisper on this machine ─────────────
# /api/transcribe spawns scripts/transcribe_worker.py once and keeps the model warm.
# Needs: python with `pip install faster-whisper` (CUDA float16 if available, else CPU int8).
# WAPSI_PYTHON=python
# WAPSI_WHISPER_MODEL=small

# DigiLocker (2026-09-07): only the mock exists. Records are generated once per PAN and kept in
# digilocker_records when a database is configured (random seed); without one the PAN seeds the person so a
# restart regenerates the same record. A real provider would be added behind lib/digilocker/types.ts.
DIGILOCKER_PROVIDER=mock
